# Copy to .env, fill in values, then load with:  set -a; . ./.env; set +a
# Never commit a populated .env file.

# HydraDB Bolt connection
HYDRAMIND_URI=neo4j://127.0.0.1:7687
HYDRAMIND_USERNAME=neo4j
# Same token graph-node reads from GRAPH_AUTH_TOKEN_FILE
HYDRAMIND_TOKEN=local-development-token-32-bytes
# HYDRAMIND_PASSWORD=   # fallback when HYDRAMIND_TOKEN is unset
HYDRAMIND_DATABASE=default

# Memory service
HYDRAMIND_SOURCE=mcp
HYDRAMIND_MAX_INFLIGHT_WRITES=8

# Stateless MCP HTTP (hydramind-http)
HYDRAMIND_MCP_HOST=127.0.0.1
HYDRAMIND_MCP_PORT=8788
HYDRAMIND_MCP_MAX_BODY_BYTES=1048576

# Dashboard (hydramind-ui)
HYDRAMIND_UI_HOST=127.0.0.1
HYDRAMIND_UI_PORT=8787
